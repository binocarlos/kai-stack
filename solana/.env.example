# Solana reference app config. Copy to .env and adjust. None of this is secret
# (the program id and RPC URLs are public); real deploy keypairs are mounted as
# files, never put here.

# --- toolbox / anchor ---
# RPC the toolbox points at for `anchor test`/deploy on localnet. Inside compose
# the surfpool service is reachable as http://surfpool:8899.
ANCHOR_PROVIDER_URL=http://surfpool:8899
ANCHOR_WALLET=/root/.config/solana/id.json

# --- frontend (Vite inlines VITE_* at build time) ---
# From the host/browser, surfpool's RPC is on localhost:8899.
VITE_RPC_URL=http://localhost:8899
# Must match declare_id! in program/programs/counter/src/lib.rs (run ./stack
# keys-sync after the first build, then paste the synced id here).
VITE_PROGRAM_ID=8yy1KCyWhqUxgebL6yvZeiA7NwLRQnEuxj9AoSSvYKTR
