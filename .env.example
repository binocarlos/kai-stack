# Copy this file to .env and fill in the values. .env is gitignored.
#
# This stack is stateless: there is no local Postgres. Both development and
# production connect to Supabase. You can point dev and prod at the same
# Supabase project, or create a separate project (or branch) for dev.

# --- OpenAI ---------------------------------------------------------------
OPENAI_KEY=sk-...
OPENAI_URL=https://api.openai.com/v1

# --- Supabase database ----------------------------------------------------
# Find these in the Supabase dashboard: Project Settings -> Database ->
# Connection string / Connection pooling.
#
# <project-ref> is your Project ID: Project Settings -> General -> "Project ID"
# (labelled "Reference used in APIs and URLs"). It is public, not a secret.
# <region> is shown next to it (e.g. eu-central-1).
#
# Use the SESSION POOLER (port 5432) or the DIRECT connection - both keep a
# 1:1 connection so GORM's prepared statements work. Do NOT use the transaction
# pooler (port 6543) for this service.
#
#   Session pooler:  host = aws-0-<region>.pooler.supabase.com
#                    user = postgres.<project-ref>
#   Direct:          host = db.<project-ref>.supabase.co
#                    user = postgres
POSTGRES_HOST=aws-0-eu-central-1.pooler.supabase.com
POSTGRES_PORT_OVERRIDE=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres.<project-ref>
# This is the DATABASE password - the Postgres login our Go backend uses. It is
# NOT an API key and NOT the publishable/secret key on the API Keys page.
# Supabase only shows it once, when the project is created; it is never
# displayed again. If you don't have it, reset it (Database section -> Settings
# -> Reset database password) and copy the new value here. The green "Connect"
# button at the top of the dashboard shows the connection string (with the
# password as a [YOUR-PASSWORD] placeholder).
POSTGRES_PASSWORD=<your-supabase-db-password>
POSTGRES_SSL=true

# Apply pending Go migrations on boot (see api/pkg/store/migrations). Set to
# false if you apply migrations out of band.
POSTGRES_AUTO_MIGRATE=true

# Connection pool - keep modest, Supabase enforces per-plan ceilings.
POSTGRES_MAX_CONNS=20
POSTGRES_IDLE_CONNS=5

# --- Server / auth --------------------------------------------------------
# SERVER_JWT_SECRET / SERVER_FIXED_PASSWORD power the local fixed-password login
# (dev/CI). WORKER_SECRET is the worker's shared secret.
SERVER_JWT_SECRET=change-me
SERVER_FIXED_PASSWORD=change-me
WORKER_SECRET=change-me

# --- Supabase Auth (Google etc.) -----------------------------------------
# The API verifies (does not issue) Supabase JWTs via the project's JWKS
# endpoint, derived from SUPABASE_URL. Enable Google in the Supabase dashboard
# (Authentication -> Providers) and add your redirect URLs there
# (Authentication -> URL Configuration -> Site URL + Redirect URLs).
#
# SUPABASE_URL is just https://<project-ref>.supabase.co (same <project-ref> as
# above). You can also copy it verbatim from Project Settings -> Data API ->
# "Project URL".
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUD=authenticated
AUTH_SUPABASE_ENABLED=true
# Keep the local fixed-password path available (set false to require Supabase).
AUTH_LOCAL_ENABLED=true

# Frontend vars. Vite inlines VITE_* into the static bundle at build time.
# VITE_SUPABASE_URL is the same Project URL as SUPABASE_URL above.
#
# VITE_SUPABASE_ANON_KEY is the browser/client key that supabase-js uses to call
# the Auth API. Get it from Project Settings -> API Keys. Paste EITHER:
#   - the new "publishable" key (sb_publishable_...)  <- preferred, or
#   - the legacy "anon"/"public" key.
# Both are designed to be public and safe in the browser.
#
# Note on Row Level Security: the RLS warning shown next to the anon key only
# matters if you query the database THROUGH Supabase's data API from the
# browser. We do NOT - the browser uses Supabase only for auth, and our Go API
# is the sole thing touching Postgres (with POSTGRES_PASSWORD) and enforces its
# own authorization. So you do NOT need to enable RLS for this stack.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-publishable-or-anon-key>

# --- Worker (background job queue) ---------------------------------------
WORKER_CONCURRENCY=10
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL=1s
