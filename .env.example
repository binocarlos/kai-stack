# Copy this file to .env and fill in the values. .env is gitignored.
#
# This stack is stateless: there is no local Postgres. Both development and
# production connect to Supabase. You can point dev and prod at the same
# Supabase project, or create a separate project (or branch) for dev.

# --- OpenAI ---------------------------------------------------------------
OPENAI_KEY=sk-...
OPENAI_URL=https://api.openai.com/v1

# --- Supabase database ----------------------------------------------------
# Find these in the Supabase dashboard: Project Settings -> Database ->
# Connection string / Connection pooling.
#
# Use the SESSION POOLER (port 5432) or the DIRECT connection - both keep a
# 1:1 connection so GORM's prepared statements work. Do NOT use the transaction
# pooler (port 6543) for this service.
#
#   Session pooler:  host = aws-0-<region>.pooler.supabase.com
#                    user = postgres.<project-ref>
#   Direct:          host = db.<project-ref>.supabase.co
#                    user = postgres
POSTGRES_HOST=aws-0-eu-west-1.pooler.supabase.com
POSTGRES_PORT_OVERRIDE=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=<your-supabase-db-password>
POSTGRES_SSL=true

# Apply pending Go migrations on boot (see api/pkg/store/migrations). Set to
# false if you apply migrations out of band.
POSTGRES_AUTO_MIGRATE=true

# Connection pool - keep modest, Supabase enforces per-plan ceilings.
POSTGRES_MAX_CONNS=20
POSTGRES_IDLE_CONNS=5

# --- Server / auth --------------------------------------------------------
SERVER_JWT_SECRET=change-me
SERVER_FIXED_PASSWORD=change-me
WORKER_SECRET=change-me

# --- Worker (background job queue) ---------------------------------------
WORKER_CONCURRENCY=10
WORKER_MAX_ATTEMPTS=3
WORKER_POLL_INTERVAL=1s
